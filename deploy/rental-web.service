[Unit]
Description=Departure rental report web service
After=network-online.target
Wants=network-online.target

[Service]
User=rental
Group=rental
WorkingDirectory=/opt/rental-reports
EnvironmentFile=/opt/rental-reports/.env
ExecStart=/opt/rental-reports/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --no-access-log
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rental-reports

[Install]
WantedBy=multi-user.target
